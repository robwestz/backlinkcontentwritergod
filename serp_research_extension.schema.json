{  "$id": "serp_research_extension.schema.json",  "$schema": "https://json-schema.org/draft/2020-12/schema",  "title": "SERP Research Extension",  "description": "Standardiserad struktur för SERP-preflight-data inom Next-A1. Används som underlag för intent_extension och BacklinkJobPackage.",  "type": "object",  "required": [    "main_query",    "cluster_queries",    "queries_rationale",    "serp_sets",    "data_confidence"  ],  "properties": {    "main_query": {      "type": "string",      "description": "Primär query härledd från target_profile/core_entities/core_topics."    },    "cluster_queries": {      "type": "array",      "description": "Minst två viktiga klusterfrågor relaterade till huvudentiteten.",      "items": {        "type": "string"      },      "minItems": 2    },    "queries_rationale": {      "type": "string",      "description": "Kort motivering till val av main_query och cluster_queries baserat på target/anchor."    },    "serp_sets": {      "type": "array",      "description": "SERP-analys per query.",      "items": {        "type": "object",        "required": [          "query",          "dominant_intent",          "page_archetypes",          "required_subtopics",          "top_results_sample"        ],        "properties": {          "query": {            "type": "string"          },          "dominant_intent": {            "type": "string",            "enum": [              "info_primary",              "commercial_research",              "transactional",              "navigational_brand",              "support",              "local",              "mixed"            ]          },          "secondary_intents": {            "type": "array",            "items": {              "type": "string"            },            "description": "Eventuella sekundära intents observerade i SERP."          },          "page_archetypes": {            "type": "array",            "description": "Sidtyper som dominerar SERP:en för denna query.",            "items": {              "type": "string",              "enum": [                "guide",                "comparison",                "category",                "product",                "review",                "tool",                "faq",                "news",                "official",                "other"              ]            }          },          "required_subtopics": {            "type": "array",            "description": "Subteman som återkommer i majoriteten av toppresultaten och bör betraktas som krav för att matcha intent/coverage.",            "items": {              "type": "string"            }          },          "top_results_sample": {            "type": "array",            "description": "Kondenserat urval av toppresultat (behöver inte vara alla 10, men tillräckligt för att spegla mönstret).",            "items": {              "type": "object",              "required": [                "rank",                "url",                "title"              ],              "properties": {                "rank": {                  "type": "integer",                  "minimum": 1                },                "url": {                  "type": "string"                },                "title": {                  "type": "string"                },                "snippet": {                  "type": "string"                },                "detected_page_type": {                  "type": "string",                  "enum": [                    "guide",                    "comparison",                    "category",                    "product",                    "review",                    "tool",                    "faq",                    "news",                    "official",                    "other"                  ]                },                "key_entities": {                  "type": "array",                  "items": {                    "type": "string"                  }                },                "key_subtopics": {                  "type": "array",                  "items": {                    "type": "string"                  }                },                "content_signals": {                  "type": "array",                  "description": "Bullets om vad sidan gör som verkar uppskattas av SERP: t.ex. 'tydliga jämförelser', 'transparenta villkor', 'risker förklaras'.",                  "items": {                    "type": "string"                  }                }              }            }          }        }      }    },    "data_confidence": {      "type": "string",      "enum": ["high", "medium", "low"],      "description": "Bedömning av hur komplett/tillförlitlig SERP-datan är."    },    "derived_intent_profile_link": {      "type": "string",      "description": "Valfritt: hur denna SERP-analys kopplas till intent_extension (t.ex. referens eller beskrivning)."    }  },  "additionalProperties": false}